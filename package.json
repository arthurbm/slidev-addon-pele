{
  "name": "slidev-addon-pele",
  "version": "0.0.0",
  "description": "Slidev addon that draws Mermaid diagram blocks with Pele instead of mermaid.js.",
  "keywords": [
    "slidev",
    "slidev-addon"
  ],
  "license": "MIT",
  "author": "arthurbm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurbm/slidev-addon-pele.git"
  },
  "files": [
    "components",
    "setup",
    "skills",
    "src",
    "styles"
  ],
  "type": "module",
  "scripts": {
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:deps",
    "dev": "pnpm --filter showcase dev",
    "fix": "ultracite fix",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "vitest run",
    "test:browser": "node test/browser/showcase.mjs",
    "test:deps": "node test/package/runtime-dependencies.mjs",
    "test:pack": "node test/package/pack.mjs",
    "typecheck": "vue-tsc --noEmit",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "pele": "1.6.0"
  },
  "devDependencies": {
    "@slidev/cli": "53.0.0",
    "@slidev/client": "53.0.0",
    "@slidev/types": "53.0.0",
    "@types/node": "^24.19.2",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.88.0",
    "typescript": "6.0.3",
    "ultracite": "8.0.1",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-tsc": "3.3.13"
  },
  "engines": {
    "node": ">=20",
    "slidev": ">=52.15.0"
  },
  "packageManager": "pnpm@11.8.0"
}
